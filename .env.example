# RepoLens uses a FREE local Ollama model — no API key needed!
#
# 1. Install Ollama: https://ollama.ai
# 2. Pull a model:   ollama pull mistral
# 3. Start Ollama:   ollama serve
# 4. Run the app:    npm run dev

# Optional: override the model (default: mistral)
# OLLAMA_MODEL=mistral

# Optional: override the Ollama URL if you run it on a different port
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: GitHub token to raise API rate limit from 60 → 5,000 req/hr
# (not required for demos — the unauthenticated limit is fine)
# GITHUB_TOKEN=ghp_...
